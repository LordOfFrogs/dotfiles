{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    {
      "type": "custom",
      "format": "┌────────────────────────── System ──────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  OS",
    },
    {
      "type": "kernel",
      "key": "┣━━  Kernel"
    },
    {
      "type": "packages",
      "key": "┣━━  Packages"
    },
    {
      "type": "shell",
      "key": "┗━━  Shell"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────── Desktop Environment ───────────────────┐"
    },
    {
      "type": "wm",
      "key": "  Window Manager"
    },
    {
      "type": "lm",
      "key": "┣━━󰍂  Login Manager"
    },
    {
      "type": "theme",
      "key": "┣━━  Theme"
    },
    {
      "type": "terminalfont",
      "key": "┣━━  Font"
    },
    {
      "type": "terminal",
      "key": "┗━━  Terminal"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────── Lenovo Yoga Pro 7i ────────────────────┐"
    },
    {
      "type": "host",
      "key": "  PC"
    },
    {
      "type": "cpu",
      "key": "┣━━  CPU"
    },
    {
      "type": "gpu",
      "key": "┣━━󰢮  GPU"
    },
    {
      "type": "display",
      "key": "┣━━󰍹  Display"
    },
    {
      "type": "memory",
      "key": "┣━━  Memory"
    },
    {
      "type": "disk",
      "key": "┗━━󰋊  Disk"
    },
    {
